{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADF-Sales-ADE-Project-PrajwalPokharkar"
		},
		"ls_blobpp01_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_blobpp01'"
		},
		"ls_AKV_ProjectPP_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://KV-SalesProject-PrajwalP.vault.azure.net/"
		},
		"SHIR-01_properties_typeProperties_linkedInfo_resourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/594b1ace-a219-4ee2-a630-9840a1563cd9/resourcegroups/rg-dev-centralindia-p001/providers/Microsoft.DataFactory/factories/adf-dev-centralindia-p001/integrationruntimes/SHIR-01"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADF-Sales-ADE-Project-PrajwalPokharkar_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_blobpp01_connectionString": {
						"value": "[parameters('ls_blobpp01_connectionString')]"
					},
					"ls_AKV_ProjectPP_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_AKV_ProjectPP_properties_typeProperties_baseUrl')]"
					},
					"SHIR-01_properties_typeProperties_linkedInfo_resourceId": {
						"value": "[parameters('SHIR-01_properties_typeProperties_linkedInfo_resourceId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}