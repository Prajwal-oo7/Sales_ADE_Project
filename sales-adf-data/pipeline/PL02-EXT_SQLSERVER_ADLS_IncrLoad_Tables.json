								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": {
										"value": "select convert(int, max(@{item().watermark_colname})) as max_processed_value from @{item().src_schema}.@{item().src_table}",
