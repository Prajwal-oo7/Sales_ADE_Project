									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_SQLSERVER_SalesDB_DynamicTB",
									"type": "DatasetReference",
									"parameters": {
										"src_schema": {
											"value": "@item().src_schema",
											"type": "Expression"
										},
										"src_table": {
											"value": "@item().src_table",
											"type": "Expression"
										}
									}
								}
							}
						}
					]
				}
			}
		],
		"folder": {
			"name": "RetailSales-project"
