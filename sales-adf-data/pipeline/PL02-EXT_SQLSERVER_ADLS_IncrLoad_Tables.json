						"type": "AzureSqlSource",
						"sqlReaderQuery": "select * from dbo.sales_watermarkTB where is_active=1;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_ASQL_sales_watermarkTB",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LKP01-Read sales_watermarkTB",
						"dependencyConditions": [
							"Succeeded"
