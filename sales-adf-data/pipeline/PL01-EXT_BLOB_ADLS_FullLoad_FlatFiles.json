{
	"name": "PL01-EXT_BLOB_ADLS_FullLoad_FlatFiles",
	"properties": {
		"activities": [
			{
				"name": "ACT_LKP01_Read_configJSON",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_ABLB_JSON_config_salesFaltFiles",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ACT_ForEach01_FileInConfig",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "ACT_LKP01_Read_configJSON",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('ACT_LKP01_Read_configJSON').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "ACT_SetVar01_Timestamp",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_Timestamp",
								"value": {
									"value": "@formatDateTime(convertFromUtc(utcNow(),'India Standard Time'\n),'yyyyMMddHHmmss')\n",
									"type": "Expression"
								}
							}
						},
						{
							"name": "ACT_COPY01_BlobSalesFlatFiles_AdlsRaw",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "ACT_SetVar01_Timestamp",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "Source",
									"value": "@{item().src_container_name}//@{item().src_file_name}"
								},
								{
									"name": "Destination",
									"value": "raw-sales/@{item().sink_folder_path}/@{concat(item().sink_file_name,'_',variables('v_Timestamp'),'.csv')}"
								}
							],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"additionalColumns": [
										{
											"name": "SOURCE_ID",
											"value": "BLB0001"
										},
										{
											"name": "DATA_DATE",
											"value": {
												"value": "@formatDateTime(convertFromUtc(utcNow(),'India Standard Time'),'dd-MM-yyyy HH:mm:ss')",
												"type": "Expression"
											}
										},
										{
											"name": "UPDATE_DATE",
											"value": {
												"value": "@formatDateTime(convertFromUtc(utcNow(),'India Standard Time'),'dd-MM-yyyy HH:mm:ss')",
												"type": "Expression"
											}
										}
									],
									"storeSettings": {
										"type": "AzureBlobStorageReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".csv"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_ABLB_SRC_Delimited_SalesFlatFiles",
									"type": "DatasetReference",
									"parameters": {
										"src_container_name": {
											"value": "@item().src_container_name",
											"type": "Expression"
										},
										"src_file_name": {
											"value": "@item().src_file_name",
											"type": "Expression"
										},
										"src_file_delimiter": {
											"value": "@item().src_file_delimiter",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_CSV_SINK_SalesRawTarget",
									"type": "DatasetReference",
									"parameters": {
										"sink_folder_path": {
											"value": "@item().sink_folder_path",
											"type": "Expression"
										},
										"sink_file_name": {
											"value": "@concat(item().sink_file_name,'_',variables('v_Timestamp'),'.csv')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "ACT_IF01-srcCount_equals_sinkCount",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "ACT_COPY01_BlobSalesFlatFiles_AdlsRaw",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(activity('ACT_COPY01_BlobSalesFlatFiles_AdlsRaw').output.rowsRead,activity('ACT_COPY01_BlobSalesFlatFiles_AdlsRaw').output.rowsCopied)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "ACT_COPY02-Adls_Target_Failure",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [
											{
												"name": "Source",
												"value": "@{'raw-sales'}/@{item().sink_folder_path}/@{concat(item().sink_file_name,'_',variables('v_Timestamp'),'.csv')}"
											},
											{
												"name": "Destination",
												"value": "@{'raw-sales'}/@{concat('blobpp01/Failure/', item().sink_file_name)}/@{concat(item().sink_file_name,'_',variables('v_Timestamp'),'.csv')}"
											}
										],
										"typeProperties": {
											"source": {
												"type": "DelimitedTextSource",
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true,
													"enablePartitionDiscovery": false
												},
												"formatSettings": {
													"type": "DelimitedTextReadSettings"
												}
											},
											"sink": {
												"type": "DelimitedTextSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "DelimitedTextWriteSettings",
													"quoteAllText": true,
													"fileExtension": ".txt"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "DS_ADLS_CSV_DynamicPath",
												"type": "DatasetReference",
												"parameters": {
													"container_name": "raw-sales",
													"folder_path": {
														"value": "@item().sink_folder_path",
														"type": "Expression"
													},
													"file_name": {
														"value": "@concat(item().sink_file_name,'_',variables('v_Timestamp'),'.csv')",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_ADLS_CSV_DynamicPath",
												"type": "DatasetReference",
												"parameters": {
													"container_name": "raw-sales",
													"folder_path": {
														"value": "blobpp01/Failure/@{item().sink_file_name}",
														"type": "Expression"
													},
													"file_name": "@concat(item().sink_file_name,'_',variables('v_Timestamp'),'.csv')"
												}
											}
										]
									},
									{
										"name": "ACT_SetVar02-v_isActivityFailed",
										"type": "SetVariable",
										"dependsOn": [
											{
												"activity": "ACT_DLT01-TargetFailedFiles",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "v_isActivityFailed",
											"value": "True"
										}
									},
									{
										"name": "ACT_DLT01-TargetFailedFiles",
										"type": "Delete",
										"dependsOn": [
											{
												"activity": "ACT_COPY02-Adls_Target_Failure",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"dataset": {
												"referenceName": "DS_ADLS_CSV_DynamicPath",
												"type": "DatasetReference",
												"parameters": {
													"container_name": "raw-sales",
													"folder_path": "@item().sink_folder_path",
													"file_name": "@concat(item().sink_file_name,'_',variables('v_Timestamp'),'.csv')"
												}
											},
											"enableLogging": false,
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": false,
												"enablePartitionDiscovery": false
											}
										}
									},
									{
										"name": "ACT_AppVar01-v_ErrorMsg",
										"type": "AppendVariable",
										"dependsOn": [
											{
												"activity": "ACT_SetVar02-v_isActivityFailed",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"userProperties": [],
										"typeProperties": {
											"variableName": "v_ErrorMsg",
											"value": {
												"value": "@concat('Validation Failed: records not copied fully! \\n Source Record count: ',activity('ACT_COPY01_BlobSalesFlatFiles_AdlsRaw').output.rowsRead,\n    '\\n Sink Record Count: ',activity('ACT_COPY01_BlobSalesFlatFiles_AdlsRaw').output.rowsCopied)",
												"type": "Expression"
											}
										}
									}
								]
							}
						},
						{
							"name": "ACT_SetVar03-v_isActivityFailed",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "ACT_COPY01_BlobSalesFlatFiles_AdlsRaw",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_isActivityFailed",
								"value": "True"
							}
						},
						{
							"name": "ACT_AppVar02-v_ErrorMsg",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "ACT_SetVar03-v_isActivityFailed",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_ErrorMsg",
								"value": {
									"value": "@activity('ACT_COPY01_BlobSalesFlatFiles_AdlsRaw').error.message",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "ACT_IF02_isActivityFailed",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "ACT_ForEach01_FileInConfig",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(variables('v_isActivityFailed'),'True' )",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "ACT_Fail01-Fail_PL01",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "ACT_SetVar04-pl01rv_errorMsg_status",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@string(join(variables('v_ErrorMsg'), '\\n'))",
									"type": "Expression"
								},
								"errorCode": "0001"
							}
						},
						{
							"name": "ACT_SetVar04-pl01rv_errorMsg_status",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "pipelineReturnValue",
								"value": [
									{
										"key": "pl01rv_errorMsg",
										"value": {
											"type": "Expression",
											"content": "@string(join(variables('v_ErrorMsg'), '\\n'))"
										}
									},
									{
										"key": "pl01rv_status",
										"value": {
											"type": "String",
											"content": "Failed"
										}
									}
								],
								"setSystemVariable": true
							}
						}
					]
				}
			}
		],
		"variables": {
			"v_Timestamp": {
				"type": "String"
			},
			"v_isActivityFailed": {
				"type": "String",
				"defaultValue": "False"
			},
			"v_ErrorMsg": {
				"type": "Array",
				"defaultValue": [
					"Null"
				]
			}
		},
		"folder": {
			"name": "RetailSales-project"
		},
		"annotations": []
	}
}