{
	"name": "PL01-EXT_BLOB_ADLS_FullLoad_FlatFiles",
	"properties": {
		"activities": [
			{
				"name": "ACT_LKP01_Read_configJSON",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_ABLB_JSON_config_salesFaltFiles",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ACT_ForEach01_FileInConfig",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "ACT_LKP01_Read_configJSON",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('ACT_LKP01_Read_configJSON').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "ACT_SetVar01_Timestamp",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_Timestamp",
								"value": {
									"value": "@formatDateTime(convertFromUtc(utcNow(),'India Standard Time'\r\n),'yyyyMMddHHmmss')\r\n",
									"type": "Expression"
								}
							}
						},
						{
							"name": "ACT_COPY01_BlobSalesFlatFiles_AdlsRaw",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "ACT_SetVar01_Timestamp",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "Source",
									"value": "@{item().src_container_name}//@{item().src_file_name}"
								},
								{
									"name": "Destination",
									"value": "raw-sales/@{item().sink_folder_path}/@{concat(item().sink_file_name,'_',variables('v_Timestamp'),'.csv')}"
								}
							],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"additionalColumns": [
										{
											"name": "SOURCE_ID",
											"value": "BLB0001"
										}
									],
									"storeSettings": {
										"type": "AzureBlobStorageReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".csv"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_ABLB_SRC_Delimited_SalesFlatFiles",
									"type": "DatasetReference",
									"parameters": {
										"src_container_name": {
											"value": "@item().src_container_name",
											"type": "Expression"
										},
										"src_file_name": {
											"value": "@item().src_file_name",
											"type": "Expression"
										},
										"src_file_delimiter": {
											"value": "@item().src_file_delimiter",
											"type": "Expression"
										},
										"src_file_type": {
											"value": "@item().src_file_type",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_CSV_SINK_SalesRawTarget",
									"type": "DatasetReference",
									"parameters": {
										"sink_folder_path": {
											"value": "@item().sink_folder_path",
											"type": "Expression"
										},
										"sink_file_name": {
											"value": "@concat(item().sink_file_name,'_',variables('v_Timestamp'),'.csv')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"variables": {
			"v_Timestamp": {
				"type": "String"
			}
		},
		"folder": {
			"name": "RetailSales-project"
		},
		"annotations": []
	}
}