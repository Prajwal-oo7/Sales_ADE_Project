{
	"name": "PL03-EmailAlert",
	"properties": {
		"activities": [
			{
				"name": "ACT_IF01-isPipelineFailed",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@pipeline().parameters.plp_isPipelineFailed",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "ACT_WEB02-emailAlert_PLSucceed",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "POST",
								"url": "https://prod-22.centralindia.logic.azure.com:443/workflows/30a1424665eb45ff9ea326f516987a6c/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=YFp7ksKnI1OjfhlmCKqwsqcCHds5ZM1CchcIDD_n4vA",
								"body": {
									"value": "{\n\"DataFactoryName\":\"@{pipeline().DataFactory}\",\n\"EmailTo\":\"prajwal007042001@gmail.com\",\n\"Subject\":\"Pipeline is Successful\",\n\"PipelineName\":\"@{pipeline().Pipeline}\",\n\"status\":\"Succesful\",\n\"ErrorMessage\":\"No error\",\n\"runId\": \"@{pipeline().RunId}\",\n\"time\": \"@{pipeline().TriggerTime}\"\n}",
									"type": "Expression"
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "ACT_WEB01-emailAlert_PLFailed",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "POST",
								"url": "https://prod-22.centralindia.logic.azure.com:443/workflows/30a1424665eb45ff9ea326f516987a6c/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=YFp7ksKnI1OjfhlmCKqwsqcCHds5ZM1CchcIDD_n4vA",
								"body": {
									"value": "{\n\"DataFactoryName\":\"@{pipeline().DataFactory}\",\n\"EmailTo\":\"prajwal007042001@gmail.com\",\n\"Subject\":\"Pipeline is Failed\",\n\"PipelineName\":\"@{pipeline().Pipeline}\",\n\"status\":\"Failed\",\n\"ErrorMessage\":@{pipeline().parameters.plp_plErrorSummary},\n\"runId\": \"@{pipeline().RunId}\",\n\"time\": \"@{pipeline().TriggerTime}\"\n}",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"plp_plErrorSummary": {
				"type": "string",
				"defaultValue": "Null"
			},
			"plp_isPipelineFailed": {
				"type": "bool",
				"defaultValue": false
			}
		},
		"folder": {
			"name": "RetailSales-project"
		},
		"annotations": []
	}
}