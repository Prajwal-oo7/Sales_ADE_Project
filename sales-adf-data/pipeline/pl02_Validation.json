{
	"name": "pl02_Validation",
	"properties": {
		"activities": [
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.ValidFilesList",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Lookup1",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobStorageReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"dataset": {
									"referenceName": "ds_blob_healthcare_controlfile",
									"type": "DatasetReference"
								}
							}
						}
					]
				}
			},
			{
				"name": "If2-recordCountMatches",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('exe-Df01_CountRecords').output.runStatus.output.sink1.value[0].recordCount\n,item().RecordCount)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Setvar3-isValidationFailed",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "isValidationFailed",
								"value": "true"
							}
						},
						{
							"name": "SetVar4-ValidationErrorMsg",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Setvar3-isValidationFailed",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "ValidationErrorMsg",
								"value": {
									"value": "@concat(\n   'Record count mismatch for ',\n   item().FileName,\n   '. Expected = ',\n   item().RecordCcount,\n   ', Actual = ',\n   activity('exe-Df01_CountRecords').output.runStatus.output.sink1.value[0].recordCount)\n)",
									"type": "Expression"
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Append variable1",
							"type": "AppendVariable",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"variableName": "ValidFileList",
								"value": {
									"value": "@item().FileName",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"ValidFilesList": {
				"type": "array"
			}
		},
		"folder": {
			"name": "Healthcare mini project"
		},
		"annotations": []
	}
}