{
	"name": "PL_Master_SalesProject-SrcFlatFile",
	"properties": {
		"activities": [
			{
				"name": "ACT_EXEPL01-FullLoad_IngestionValidation",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL01-EXT_BLOB_ADLS_FullLoad_FlatFiles",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "ACT_EXEPL02-EXT_SqlServer_Sales_IncrLoad",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL02-EXT_SQLSERVER_ADLS_IncrLoad_Tables",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "ACT_EXEPL03-EmailAlert",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "ACT_SetVar01-v_isPipelineFailed",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL03-EmailAlert",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"plp_plErrorSummary": {
							"value": "@string(join(variables('v_plErrorList'), '\\n'))",
							"type": "Expression"
						},
						"plp_isPipelineFailed": {
							"value": "@variables('v_isPipelineFailed')",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "ACT_SetVar01-v_isPipelineFailed",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "ACT_AppVar02-v_plErrorList_copy1",
						"dependencyConditions": [
							"Succeeded",
							"Failed"
						]
					},
					{
						"activity": "ACT_AppVar01-v_plErrorList",
						"dependencyConditions": [
							"Succeeded",
							"Failed"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_isPipelineFailed",
					"value": true
				}
			},
			{
				"name": "ACT_AppVar01-v_plErrorList",
				"type": "AppendVariable",
				"dependsOn": [
					{
						"activity": "ACT_EXEPL01-FullLoad_IngestionValidation",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_plErrorList",
					"value": {
						"value": "@concat(\n  'Pipeline: Child Pipeline: ACT_EXEPL01-FullLoad_IngestionValidation',\n  '\\nError: ',\n  activity('ACT_EXEPL01-FullLoad_IngestionValidation').output.pipelineReturnValue.pl01rv_errorMsg\n)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ACT_AppVar02-v_plErrorList_copy1",
				"type": "AppendVariable",
				"dependsOn": [
					{
						"activity": "ACT_EXEPL02-EXT_SqlServer_Sales_IncrLoad",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_plErrorList",
					"value": {
						"value": "@concat(\n  'Pipeline: Child Pipeline: ACT_EXEPL02-EXT_SqlServer_Sales_IncrLoad',\n  '\\nError: ',\nactivity('ACT_EXEPL02-EXT_SqlServer_Sales_IncrLoad').output.pipelineReturnValue.pl02rv_errorMsg\n)",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"v_plErrorList": {
				"type": "Array"
			},
			"v_isPipelineFailed": {
				"type": "Boolean",
				"defaultValue": false
			}
		},
		"folder": {
			"name": "RetailSales-project"
		},
		"annotations": []
	}
}