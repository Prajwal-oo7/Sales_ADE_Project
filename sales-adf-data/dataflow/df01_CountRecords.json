{
	"name": "df01_CountRecords",
	"properties": {
		"folder": {
			"name": "Healthcare MIni Project-01"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_blobcsv_HealthcareFlatFiles",
						"type": "DatasetReference"
					},
					"name": "dfSource1"
				}
			],
			"sinks": [
				{
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     df_FileName as string,",
				"     df_Container as string",
				"}",
				"source(output(",
				"          diagnosis_code as string,",
				"          diagnosis_description as string,",
				"          icd_version_type as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false) ~> dfSource1",
				"dfSource1 aggregate(recordCount = count()) ~> aggregate1",
				"aggregate1 sink(validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     keys:['recordCount'],",
				"     store: 'cache',",
				"     format: 'inline',",
				"     output: true,",
				"     saveOrder: 1) ~> sink1"
			]
		}
	}
}